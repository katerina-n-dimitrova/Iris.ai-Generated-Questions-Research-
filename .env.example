# ---- OpenAI (chat / answer generation; embeddings only if backend=openai) ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Embeddings ----
# backend: huggingface (default) or openai
EMBEDDING_BACKEND=huggingface
HF_EMBEDDING_MODEL=Octen/Octen-Embedding-0.6B
# HF_EMBEDDING_DEVICE=cpu        # cpu | cuda | mps (auto-detected if blank)
# HF_QUERY_PROMPT_NAME=query     # set only if the model defines a query prompt
HF_BATCH_SIZE=32

# ---- ChromaDB ----
# mode: local (on-disk persistent, no key) | cloud (hosted Chroma Cloud)
CHROMA_MODE=local
CHROMA_PERSIST_DIR=./chroma_indexes
CHROMA_COLLECTION_PREFIX=context_enrichment_rag

# Chroma Cloud (only used when CHROMA_MODE=cloud) — paste your credentials here:
CHROMA_API_KEY=your_chroma_cloud_api_key_here
CHROMA_TENANT=your_chroma_tenant_here
CHROMA_DATABASE=your_chroma_database_here

# ---- Paths ----
DATA_DIR=./data
RESULTS_DIR=./results

# ---- Experiment knobs ----
MAX_DATASET_SAMPLES=300
TOP_K=5
