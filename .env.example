# ---- OpenAI (question generation; embeddings only if backend=openai) ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Embeddings ----
# backend: huggingface | openai | iris — every presentation run used iris (dim-384)
EMBEDDING_BACKEND=iris
IRIS_EMBEDDINGS_URL=https://llm-api-dev.iris.ai/embeddings/generate/
# IRIS_API_KEY=your_iris_token_here
# IRIS_BATCH_SIZE=64
# IRIS_TIMEOUT=120

# ---- Hugging Face backend (only if EMBEDDING_BACKEND=huggingface; needs `uv sync --extra hf`) ----
# HF_EMBEDDING_MODEL=Octen/Octen-Embedding-0.6B
# HF_EMBEDDING_DEVICE=cpu        # cpu | cuda | mps (auto-detected if blank)
# HF_BATCH_SIZE=32

# ---- Iris-hosted Qwen chat endpoint (exp/qwen_generator only) ----
# IRIS_LLM_BASE_URL=https://chat-api-dev.iris.ai/v1/
# IRIS_LLM_API_KEY=EMPTY
# IRIS_LLM_MODEL=Qwen/Qwen3.5-4B
# IRIS_LLM_TIMEOUT=180
# IRIS_LLM_MAX_TOKENS=8192
